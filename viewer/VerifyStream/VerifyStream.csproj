<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IRPanoView.VerifyStream</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\IRPanoView.Viewer\Display\*.cs" Link="Display\%(Filename)%(Extension)" />
    <Compile Include="..\IRPanoView.Viewer\Network\ThermalFrameParser.cs" Link="Network\ThermalFrameParser.cs" />
    <Compile Include="..\IRPanoView.Viewer\Network\ThermalChunkReassembler.cs" Link="Network\ThermalChunkReassembler.cs" />
  </ItemGroup>
</Project>
